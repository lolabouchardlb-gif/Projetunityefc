  m_Script: {fileID: 11500000, guid: b3674a0e9b44514428c367042e3279cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizGameManager
  _questions:
  - QuestionText: "Depuis combien de temps les Wolastoqiyik sont-ils pr\xE9sents
      sur leur territoire ?"
    Answers:
    - A. 500 ans
    - B. 2 000 ans
    - C. Plus de 8 000 ans
    CorrectAnswerIndex: 2
  - QuestionText: "Quelle alliance regroupait les Wolastoqiyik avec d\u2019autres
      nations de l\u2019Est ?"
    Answers:
    - "A. L\u2019Alliance du Nord"
    - "B. La Conf\xE9d\xE9ration Wabanaki"
    - "C. Le Conseil des Premi\xE8res Nations"
    CorrectAnswerIndex: 1
  - QuestionText: "\xC0 quoi servaient les chemins de portage ?"
    Answers:
    - "A. \xC0 cultiver la terre"
    - "B. \xC0 se d\xE9placer entre diff\xE9rents cours d\u2019eau"
    - "C. \xC0 construire des habitations"
    CorrectAnswerIndex: 1
  - QuestionText: "Quelle r\xE9serve est associ\xE9e \xE0 l\u2019histoire des Wolastoqiyik
      au Qu\xE9bec ?"
    Answers:
    - A. Wendake
    - B. Viger
    - C. Mashteuiatsh
    CorrectAnswerIndex: 1
  - QuestionText: "En quelle ann\xE9e la nation a-t-elle \xE9t\xE9 reconnue officiellement
      au Qu\xE9bec ?"
    Answers:
    - A. 1763
    - B. 1989
    - C. 2005
    CorrectAnswerIndex: 1
