  m_Script: {fileID: 11500000, guid: 7bb8510f854f8dc4fb3696af66c4a7ec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MapPoint
  _title: Les Innus
  _description: "Les Innus sont un peuple autochtone de l\u2019Est du Canada vivant
    principalement sur la C\xF4te-Nord du Qu\xE9bec et au Labrador. Leur territoire
    ancestral, le Nitassinan, occupe une place centrale dans leur culture et leurs
    traditions. Aujourd\u2019hui, les Innus continuent de pr\xE9server leur langue,
    l\u2019innu-aimun, ainsi que leur lien avec la nature et leur identit\xE9."
  _sceneName: ChoixExplicationInnus
  _panelController: {fileID: 347191436}
