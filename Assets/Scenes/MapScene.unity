  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MapPoint
  _title: Les Cris
  _description: "Les Cris sont un peuple autochtone vivant principalement dans le
    nord du Qu\xE9bec, autour de la Baie-James. Depuis des milliers d\u2019ann\xE9es,
    leur mode de vie est li\xE9 \xE0 la chasse, \xE0 la p\xEAche et au territoire.
    Aujourd\u2019hui, ils continuent de pr\xE9server leur langue, leurs traditions
    et leur culture tout en s\u2019adaptant au monde moderne."
  _sceneName: ChoixExplicationCris
  _panelController: {fileID: 347191436}
