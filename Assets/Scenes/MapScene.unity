  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MapPoint
  _title: Les Wolastoqiyik
  _description: "Les Wolastoqiyik, aussi appel\xE9s Mal\xE9cites, sont un peuple
    autochtone de l\u2019Est du Canada. Pr\xE9sents depuis des milliers d\u2019ann\xE9es,
    ils vivaient principalement de la chasse, de la p\xEAche et des \xE9changes le
    long de la rivi\xE8re Wolastoq. Aujourd\u2019hui, ils continuent de pr\xE9server
    leur culture, leur langue et leurs traditions."
  _sceneName: ChoixExplicationMalecite
  _panelController: {fileID: 347191436}
